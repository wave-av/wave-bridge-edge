#!/usr/bin/env bash
# Verbatim `run:` body of GitHub Actions step
#   image-content-gate.yml / job ndi / step [3] "scan the flattened filesystem AND every individual layer"
# at wave-av/wave-bridge-edge 698f7f7509c9. Do not edit by hand: re-extract from the workflow (see .buildkite/README.md).
# gh-shell: default
# gh-env: IMAGE=wave-ndi-bridge:ci
# gh-env: CONTEXT=containers/ndi
# gh-env: DOCKERFILE=
# gh-env: BUILD_ARGS=
# gh-env: FORBID=libndi|ndi-discovery-server|ndi-record|ndi-embedded-bridge|ndi-benchmark
# gh-env: CONTROL=usr/local/bin/entrypoint.sh
# gh-env: REASON=wave-av/wave-ndi-edge containers/ndi/LICENSING.md
# gh-env: ADVISORY=false
# Run by .buildkite/scripts/lib/common.sh as `bash -e <this file>` (GH default shell), or `bash -eo pipefail` when the step set `shell: bash`.
set -euo pipefail
work="$(mktemp -d)"
cid=""
# shellcheck disable=SC2329  # invoked via trap, not directly
cleanup() { [ -n "$cid" ] && docker rm -f "$cid" >/dev/null 2>&1 || true; rm -rf "$work"; }
trap cleanup EXIT

findings=0

# ── 1. flattened filesystem ────────────────────────────────────────────────────────────
echo "--> [1/2] flattened image filesystem"
cid="$(docker create "$IMAGE")" || { echo "::error::COULD-NOT-SCAN: docker create failed"; exit 2; }
docker export "$cid" | tar -t > "$work/flat.txt" || { echo "::error::COULD-NOT-SCAN: docker export failed"; exit 2; }
echo "    entries: $(wc -l < "$work/flat.txt")"
grep -qF "$CONTROL" "$work/flat.txt" || {
  echo "::error::COULD-NOT-SCAN: positive control '${CONTROL}' is absent from the flattened"
  echo "::error::listing, so a zero out of it would not be a measurement. Fix control-path."
  exit 2
}
if grep -E "$FORBID" "$work/flat.txt"; then
  echo "::error::A forbidden path is in the image filesystem. See ${REASON}."
  findings=1
else
  echo "OK: flattened filesystem is clean."
fi

# ── 2. every individual layer ──────────────────────────────────────────────────────────
# This is the assertion the flattened scan CANNOT make. `docker save` emits the blobs that
# are pushed; a whiteout hides content from (1) but not from the blob.
echo "--> [2/2] every individual image LAYER"
docker save "$IMAGE" -o "$work/image.tar" || { echo "::error::COULD-NOT-SCAN: docker save failed"; exit 2; }
mkdir -p "$work/save"
tar -xf "$work/image.tar" -C "$work/save" || { echo "::error::COULD-NOT-SCAN: could not unpack docker save output"; exit 2; }
: > "$work/layers.txt"
layers=0
# Blobs are a mix of JSON (manifest/config) and layer tarballs; `tar -tf` fails on the JSON
# ones, and its auto-detection handles both gzipped and plain layers.
while IFS= read -r blob; do
  if tar -tf "$blob" > "$work/one.txt" 2>/dev/null; then
    layers=$((layers + 1))
    cat "$work/one.txt" >> "$work/layers.txt"
  fi
done < <(find "$work/save" -type f ! -name '*.json')
echo "    layers scanned: ${layers}; entries across all layers: $(wc -l < "$work/layers.txt")"
[ "$layers" -gt 0 ] || {
  echo "::error::COULD-NOT-SCAN: no layer tarballs found in \`docker save\` output — the"
  echo "::error::per-layer scan measured nothing at all."
  exit 2
}
grep -qF "$CONTROL" "$work/layers.txt" || {
  echo "::error::COULD-NOT-SCAN: positive control '${CONTROL}' is absent from the union of"
  echo "::error::all ${layers} layers. The per-layer listing is not trustworthy."
  exit 2
}
if grep -E "$FORBID" "$work/layers.txt"; then
  echo "::error::A forbidden path is in an image LAYER. Even if a later layer deletes it,"
  echo "::error::the layer blob is still pushed to the registry. See ${REASON}."
  findings=1
else
  echo "OK: clean across all ${layers} layers."
fi

# ── verdict ────────────────────────────────────────────────────────────────────────────
if [ "$findings" -eq 0 ]; then
  echo "==> image-content-gate PASSED for ${IMAGE} (${layers} layers) — clear to publish."
  exit 0
fi
if [ "$ADVISORY" = "true" ]; then
  echo "::warning::image-content-gate found forbidden content, but this caller is advisory."
  echo "::warning::The image is NOT clear to publish. Flip advisory to false once clean."
  exit 0
fi
echo "::error::image-content-gate FAILED for ${IMAGE} — this image must not be published."
exit 1
